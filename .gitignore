# Core-code-only repository: ignore everything unless explicitly allowed.
/*

# Repository metadata and documentation
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/requirements.txt
!/pytest.ini

# Core Python implementation
!/config.py
!/dgp.py
!/methods.py
!/simulation.py
!/analysis.py
!/realdata.py

# Native C source; compiled libraries remain local
!/csrc/
/csrc/*
!/csrc/cfr_core.c

# Reproducibility helpers
!/scripts/
/scripts/*
!/scripts/__init__.py
!/scripts/benchmark.py
!/scripts/realdata_sensitivity.py

# Tests
!/tests/
/tests/*
!/tests/test_*.py

# Defensive exclusions for generated or local material
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.dll
**/*.so
**/*.dylib
**/*.jsonl
**/*.parquet
**/*.npz
