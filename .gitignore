# Source repository with compact reproduction references; allow listed paths only.
/*

# Repository metadata and documentation
!/.gitignore
!/.gitattributes
!/README.md
!/README.txt
!/CHANGELOG.md
!/LICENSE
!/CITATION.cff
!/requirements.txt
!/ruff.toml
!/.clang-format
!/pytest.ini

# Core Python implementation
!/config.py
!/dgp.py
!/methods.py
!/simulation.py
!/analysis.py
!/realdata.py
!/reproduce.py

# Compact, versioned reproducibility documentation and aggregate references
!/reproducibility/
/reproducibility/*
!/reproducibility/*.md
!/reproducibility/*.txt
!/reproducibility/*.json
!/reproducibility/reference/
/reproducibility/reference/*
!/reproducibility/reference/*.csv
!/reproducibility/reference/*.json
!/reproducibility/reference/application_arrays.npz

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml

# Native C source; compiled libraries remain local
!/csrc/
/csrc/*
!/csrc/cfr_core.c

# Reproducibility helpers
!/scripts/
/scripts/*
!/scripts/__init__.py
!/scripts/benchmark.py
!/scripts/realdata_sensitivity.py

# Tests
!/tests/
/tests/*
!/tests/test_*.py

# Defensive exclusions for generated or local material
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.dll
**/*.so
**/*.dylib
**/*.jsonl
**/*.parquet
**/*.npz
!/reproducibility/reference/application_arrays.npz
